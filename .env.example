# Copy to `.env` and fill in. `run.sh` loads this automatically.
# Never commit the real .env (it is gitignored).

# --- Nebius Token Factory (the default in config/settings.yaml) ---
# API key for Nebius, which serves the NVIDIA Nemotron model over an
# OpenAI-compatible endpoint. Get it from your Nebius AI Studio / Token
# Factory account. Required whenever llm.provider is "openai_compatible" with
# a remote base_url (the hackathon setup).
NEBIUS_API_KEY=

# --- Hosted OpenAI (fallback) ---
# Used only if you switch llm.provider back to "openai". If NEBIUS_API_KEY is
# unset, the client falls back to this key.
OPENAI_API_KEY=

# --- Tavily web search (optional, enables the web_search tool) ---
# Free key at https://tavily.com. Without it, web_search is simply not offered;
# with it, the assistant can look things up online (hackathon Tavily bonus).
TAVILY_API_KEY=

# Optional: overrides the LLM model from config/settings.yaml.
# Equivalent to `./run.sh --model <name>`.
# LLM_MODEL_OVERRIDE=nvidia/Llama-3_3-Nemotron-Super-49B-v1
